.version 8.8
.target sm_120
.address_size 64

// uint32_t output[i] = input[i] * 3 + 7; n is a multiple of 256.
.visible .entry affine(.param .u64 input, .param .u64 output, .param .u32 n) {
    .reg .pred p;
    .reg .b32 r<10>;
    .reg .b64 rd<6>;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;
    nanosleep.u32 0;

    ld.param.u64 rd0, [input];
    ld.param.u64 rd1, [output];
    ld.param.u32 r0, [n];
    mov.u32 r1, %tid.x;
    mov.u32 r2, %ctaid.x;
    mad.lo.u32 r3, r2, 256, r1;
    setp.ge.u32 p, r3, r0;
    @p bra done;
    mul.wide.u32 rd2, r3, 4;
    add.u64 rd3, rd0, rd2;
    add.u64 rd4, rd1, rd2;
    ld.global.u32 r4, [rd3];
    mad.lo.u32 r5, r4, 3, 7;
    st.global.u32 [rd4], r5;
done:
    ret;
}

.visible .entry sentinel(.param .u64 output) {
    .reg .b64 rd;
    .reg .b32 r;
    ld.param.u64 rd, [output];
    mov.u32 r, 123;
    st.global.u32 [rd], r;
    ret;
}
